{
  "name": "uat-reel",
  "version": "0.1.0",
  "description": "Record storyboarded UAT videos with Playwright and driver.js: red-box highlights, captions, and review packs for adversarial review.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "uat-reel": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js && node dist/cli.js schema > schema.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "readme-media": "node scripts/readme-media.mjs"
  },
  "keywords": [
    "playwright",
    "driver.js",
    "uat",
    "demo",
    "screen-recording",
    "subtitles",
    "claude-code",
    "skill"
  ],
  "dependencies": {
    "driver.js": "^1.10.2",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwannoel/uat-reel.git"
  },
  "homepage": "https://github.com/kwannoel/uat-reel#readme"
}
